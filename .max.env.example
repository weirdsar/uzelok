# Скопируйте этот файл в КОРЕНЬ проекта (.max.env) — он в .gitignore.
# Права: 600.
#
# Получить токен Bot API для MAX: https://max.ru (раздел для разработчиков / Bot API).
# user_id — ID пользователя-получателя уведомлений (ваш ID в MAX).
#
# Формат:
# token=YOUR_MAX_BOT_TOKEN_HERE
# user_id=123456789
#
# Пустой/неполный файл — уведомления в MAX молча пропускаются (только Telegram + email).

token=YOUR_MAX_BOT_TOKEN_HERE
user_id=0
